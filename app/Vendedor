class Vendedor extends Empleado {
    private double totalVentas;

    public Vendedor(String identificacion, String nombre, int edad, int añoIngreso, double salarioBasico, double totalVentas) {
        super(identificacion, nombre, edad, anioIngreso, salarioBasico);
        this.totalVentas = totalVentas;
    }

    public void liquidarNomina() {
        double comision = totalVentas * 0.15;
        double salario = salarioBasico + comision;

        if ((2026 - añoIngreso) > 20) {
            salario += 100000;
        }

        double descuento = salario * 0.10;
        double neto = salario - descuento;

        System.out.println("Vendedor, " + identificacion + ", " + nombre + ", " + añoIngreso +
                ", " + salarioBasico + ", " + totalVentas + ", " + comision + ", " + descuento + ", " + neto);
    }
}
