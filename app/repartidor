class Repartidor extends Empleado {
    private int numeroRepartos;
    private String zona;

    public Repartidor(String identificacion, String nombre, int edad, int anioIngreso, double salarioBasico, int numeroRepartos, String zona) {
        super(identificacion, nombre, edad, anioIngreso, salarioBasico);
        this.numeroRepartos = numeroRepartos;
        this.zona = validarZona(zona);
    }

    private String validarZona(String zona) {
        switch (zona) {
            case "A":
            case "B":
            case "C":
            case "D":
                return zona;
            default:
                return "C";
        }
    }

    public void liquidarNomina() {
        double pagoRepartos = numeroRepartos * 10000;
        double salario = salarioBasico + pagoRepartos;

        if ((2026 - anioIngreso) >= 5 && zona == "C") {
            salario += 50000;
        }

        double descuento = salario * 0.10;
        double neto = salario - descuento;

        System.out.println("Repartidor, " + identificacion + ", " + nombre + ", " + anioIngreso +
                ", " + salarioBasico + ", " + numeroRepartos + ", " + pagoRepartos + ", " + descuento + ", " + neto);
    }
}
